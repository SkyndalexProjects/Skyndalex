generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Custombots {
  id       Int    @default(autoincrement())
  guildId  String
  token    String
  activity String @default("Skyndalex v2.0 | discord.skyndalex.com")
  status   String @default("offline")
  clientId String

  @@id([id, guildId])
}

model Settings {
  guildId         String   @id
  autoRole        String?
  welcomeChannel  String?
  welcomeTitle    String?
  goodbyeTitle    String?
  blockedCommands String[] @default([])
  blockedChannels String[] @default([])
  goodbyeChannel  String?
  djRole          String?
}

model DashboardLogs {
  id      Int     @id @default(autoincrement())
  guildId String
  value   String?
  userId  String?
  date    BigInt?
}

model Users {
  type     String @default("normal")
  userId   String @id
  username String
  avatar   String
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  discordId     String?   @unique

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Economy {
  id             String    @id @default(cuid())
  userId         String    @unique
  wallet         BigInt    @default(0)
  bank           BigInt    @default(0)
  xp             BigInt    @default(0)
  level          BigInt    @default(1)
  dailyStreak    BigInt    @default(0)
  lastDailyAt    DateTime?
  lastActiveAt   DateTime?
  dailyClaimedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([level])
  @@index([xp])
  @@map("economy")
}

model EconomyTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    BigInt
  type      String
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("economy_transactions")
}

enum CollectibleStatus {
  PENDING
  ACTIVE
  SOLD
  TRADED
  BURNED
  EXPIRED
}

enum CollectibleRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model Collectible {
  id     String @id @default(cuid())
  userId String

  imageUrl String
  prompt   String?

  rarity CollectibleRarity @default(COMMON)
  value  BigInt

  attack  BigInt?
  defense BigInt?
  luck    BigInt?

  status    CollectibleStatus @default(PENDING)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([rarity])
  @@index([value])
  @@map("collectibles")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum RadioProvider {
  RADIO_GARDEN  @map("radio.garden")
  RADIO_BROWSER @map("radio-browser")
}

model RadioRecentPlays {
  id          Int           @id @default(autoincrement())
  guildId     String
  userId      String
  provider    RadioProvider
  stationName String
  playedAt    DateTime      @default(now())
}

model RadioFavorites {
  id            Int           @id @default(autoincrement())
  userId        String
  provider      RadioProvider
  stationName   String
  stationSource String
  resourceUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, provider, stationSource])
  @@index([userId])
}
