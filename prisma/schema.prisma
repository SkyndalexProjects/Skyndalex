generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Tokens {
  id               Int    @default(autoincrement())
  userId           String @id
  huggingFaceToken String
}
model Custombots {
  id       Int    @default(autoincrement())
  guildId  String
  token    String
  activity String @default("Skyndalex v2.0 | discord.skyndalex.com")
  status   String @default("offline")
  clientId String

  @@id([id, guildId])
}

model DashboardLogs {
  id      Int     @id @default(autoincrement())
  guildId String
  value   String?
  userId  String?
  date    BigInt?
}
model Users {
  type     String @default("normal")
  userId   String @id
  username String
  avatar   String
}
